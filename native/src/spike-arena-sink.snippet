    #[test]
    #[ignore = "diagnostic timing; run explicitly in release mode"]
    fn profile_arena_sink() {
        use html5ever::tendril::StrTendril;
        use html5ever::tree_builder::{ElementFlags, NodeOrText, QuirksMode, TreeSink};
        use html5ever::{Attribute, QualName};

        /// Detaches `id` from its parent and siblings.
        fn arena_detach(nodes: &mut Vec<arena::DomNode>, id: u32) {
            let (parent, previous, next) = match (
                nodes[id as usize].parent,
                nodes[id as usize].prev,
                nodes[id as usize].next,
            ) {
                (Some(parent), previous, next) => (parent, previous, next),
                _ => return,
            };
            if let Some(previous) = previous {
                nodes[previous as usize].next = next;
            }
            if let Some(next) = next {
                nodes[next as usize].prev = previous;
            }
            let siblings = &mut nodes[parent as usize].children;
            if let Some(position) = siblings.iter().position(|child| *child == id) {
                siblings.remove(position);
            }
            let record = &mut nodes[id as usize];
            record.parent = None;
            record.prev = None;
            record.next = None;
        }

        /// Links `id` as the last child of `parent`.
        fn arena_link_last_child(nodes: &mut Vec<arena::DomNode>, parent: u32, id: u32) {
            let previous = nodes[parent as usize].children.last().copied();
            let record = &mut nodes[id as usize];
            record.parent = Some(parent);
            record.prev = previous;
            record.next = None;
            if let Some(previous) = previous {
                nodes[previous as usize].next = Some(id);
            }
            nodes[parent as usize].children.push(id);
        }

        /// Appends text to `parent`, concatenating into a trailing text node.
        fn arena_push_text(nodes: &mut Vec<arena::DomNode>, parent: u32, text: &StrTendril) {
            if let Some(&last) = nodes[parent as usize].children.last() {
                if nodes[last as usize].kind.as_ref() == "text" {
                    nodes[last as usize]
                        .data
                        .as_mut()
                        .expect("text node without data")
                        .push_str(&text);
                    return;
                }
            }
            let id = nodes.len() as u32;
            let mut record = arena::DomNode::new("text");
            record.id = id;
            record.data = Some(String::from(&**text));
            nodes.push(record);
            arena_link_last_child(nodes, parent, id);
        }

        /// Inserts text immediately before `sibling`, concatenating into a
        /// preceding text node.
        fn arena_insert_text_before(
            nodes: &mut Vec<arena::DomNode>,
            sibling: u32,
            text: &StrTendril,
        ) {
            let (parent, previous) = {
                let record = &nodes[sibling as usize];
                (record.parent.expect("sibling without parent"), record.prev)
            };
            if let Some(previous) = previous {
                if nodes[previous as usize].kind.as_ref() == "text" {
                    nodes[previous as usize]
                        .data
                        .as_mut()
                        .expect("text node without data")
                        .push_str(&text);
                    return;
                }
            }
            let id = nodes.len() as u32;
            let mut record = arena::DomNode::new("text");
            record.id = id;
            record.data = Some(String::from(&**text));
            record.parent = Some(parent);
            record.prev = Some(previous);
            record.next = Some(sibling);
            nodes[previous as usize].next = Some(id);
            nodes[sibling as usize].prev = Some(id);
            let siblings = &mut nodes[parent as usize].children;
            let position = siblings
                .iter()
                .position(|child| *child == sibling)
                .expect("sibling not under parent");
            siblings.insert(position, id);
            nodes.push(record);
        }

        /// A TreeSink that builds arena-shaped records directly, allocating
        /// exactly what `convert_node` allocates (String names and data,
        /// `Value::String` attribute values, per-element namespace/prefix
        /// boxes, SmallVec children), so the measurement reflects the
        /// arena-primary refactor's construction cost.
        struct ArenaSink {
            nodes: std::cell::RefCell<Vec<arena::DomNode>>,
            names: std::cell::RefCell<Vec<QualName>>,
            quirks: std::cell::Cell<QuirksMode>,
        }

        impl TreeSink for ArenaSink {
            type Handle = u32;
            type Output = Vec<arena::DomNode>;
            type ElemName<'a> = std::cell::Ref<'a, QualName>;

            fn finish(mut self) -> Self::Output {
                let mode = match self.quirks.get() {
                    QuirksMode::Quirks => "quirks",
                    QuirksMode::LimitedQuirks => "limited-quirks",
                    QuirksMode::NoQuirks => "no-quirks",
                };
                let mut nodes = self.nodes.into_inner();
                nodes[0].extras.insert(
                    "x-mode".into(),
                    serde_json::Value::String(mode.into()),
                );
                nodes
            }
            fn parse_error(&self, _message: std::borrow::Cow<'static, str>) {}
            fn get_document(&self) -> u32 {
                0
            }
            fn elem_name<'a>(&'a self, target: &'a u32) -> Self::ElemName<'a> {
                std::cell::Ref::map(self.names.borrow(), |names| &names[*target as usize])
            }
            fn create_element(
                &self,
                name: QualName,
                attrs: Vec<Attribute>,
                _flags: ElementFlags,
            ) -> u32 {
                let mut nodes = self.nodes.borrow_mut();
                let id = nodes.len() as u32;
                let mut record = arena::DomNode::new(if name.local.as_ref() == "script" {
                    "script"
                } else if name.local.as_ref() == "style" {
                    "style"
                } else {
                    "tag"
                });
                record.id = id;
                record.name = Some(String::from(name.local.as_ref()));
                record.namespace = Some(arena::namespace_name(&name.ns));
                let mut attribs = arena::Attributes::with_capacity(attrs.len());
                let mut namespaces = serde_json::Map::new();
                let mut prefixes = serde_json::Map::new();
                for attr in attrs {
                    let key = String::from(attr.name.local.as_ref());
                    if !attr.name.ns.is_empty() {
                        namespaces.insert(
                            key.clone(),
                            serde_json::Value::String(String::from(attr.name.ns.as_ref())),
                        );
                    }
                    if let Some(prefix) = &attr.name.prefix {
                        prefixes.insert(
                            key.clone(),
                            serde_json::Value::String(String::from(&**prefix)),
                        );
                    }
                    attribs.insert(
                        key,
                        serde_json::Value::String(String::from(&*attr.value)),
                    );
                }
                record.attribs = attribs;
                record.attribs_namespace = Some(Box::new(namespaces));
                record.attribs_prefix = Some(Box::new(prefixes));
                if let Some(prefix) = &name.prefix {
                    record.extras.insert(
                        "prefix".into(),
                        serde_json::Value::String(String::from(&**prefix)),
                    );
                }
                let is_template = name.local.as_ref() == "template";
                nodes.push(record);
                self.names.borrow_mut().push(name);
                let element = id;
                if is_template {
                    // The integration-point fragment child a template carries.
                    let fragment = nodes.len() as u32;
                    let mut record = arena::DomNode::new("root");
                    record.id = fragment;
                    nodes.push(record);
                    arena_link_last_child(&mut nodes, element, fragment);
                    return fragment;
                }
                element
            }
            fn create_comment(&self, text: StrTendril) -> u32 {
                let mut nodes = self.nodes.borrow_mut();
                let id = nodes.len() as u32;
                let mut record = arena::DomNode::new("comment");
                record.id = id;
                record.data = Some(String::from(&**text));
                nodes.push(record);
                id
            }
            fn append_doctype_to_document(
                &self,
                name: StrTendril,
                public_id: StrTendril,
                system_id: StrTendril,
            ) {
                let mut nodes = self.nodes.borrow_mut();
                let id = nodes.len() as u32;
                let mut record = arena::DomNode::new("directive");
                record.id = id;
                record.name = Some("!doctype".into());
                record.extras.insert(
                    "x-name".into(),
                    serde_json::Value::String(String::from(&*name)),
                );
                record.extras.insert(
                    "x-publicId".into(),
                    serde_json::Value::String(String::from(&*public_id)),
                );
                record.extras.insert(
                    "x-systemId".into(),
                    serde_json::Value::String(String::from(&*system_id)),
                );
                let mut data = format!("!DOCTYPE {}", name);
                if !public_id.is_empty() {
                    data.push_str(" PUBLIC ");
                    data.push_str(&public_id);
                    if !system_id.is_empty() {
                        data.push_str(" \"");
                        data.push_str(&system_id);
                        data.push('"');
                    }
                } else if !system_id.is_empty() {
                    data.push_str(" SYSTEM \"");
                    data.push_str(&system_id);
                    data.push('"');
                }
                record.data = Some(data);
                nodes.push(record);
                arena_link_last_child(&mut nodes, 0, id);
            }
            fn append(&self, parent: &u32, child: NodeOrText<u32>) {
                let mut nodes = self.nodes.borrow_mut();
                match child {
                    NodeOrText::AppendNode(id) => {
                        arena_detach(&mut nodes, id);
                        arena_link_last_child(&mut nodes, *parent, id);
                    }
                    NodeOrText::AppendText(text) => arena_push_text(&mut nodes, *parent, &text),
                }
            }
            fn append_before_sibling(&self, sibling: &u32, new_node: NodeOrText<u32>) {
                let mut nodes = self.nodes.borrow_mut();
                if let NodeOrText::AppendNode(id) = new_node {
                    arena_detach(&mut nodes, id);
                }
                let (parent, previous) = {
                    let record = &nodes[*sibling as usize];
                    (record.parent, record.prev)
                };
                let Some(parent) = parent else { return };
                match new_node {
                    NodeOrText::AppendNode(id) => {
                        let record = &mut nodes[id as usize];
                        record.parent = Some(parent);
                        record.prev = previous;
                        record.next = Some(*sibling);
                        if let Some(previous) = previous {
                            nodes[previous as usize].next = Some(id);
                        }
                        nodes[*sibling as usize].prev = Some(id);
                        let siblings = &mut nodes[parent as usize].children;
                        let position = siblings
                            .iter()
                            .position(|child| *child == id)
                            .expect("detached node not found under parent");
                        siblings.insert(position, id);
                    }
                    NodeOrText::AppendText(text) => arena_insert_text_before(&mut nodes, *sibling, &text),
                }
            }
            fn append_based_on_parent_node(
                &self,
                element: &u32,
                previous_element: &u32,
                child: NodeOrText<u32>,
            ) {
                let has_parent = self.nodes[*element as usize].parent.is_some();
                if has_parent {
                    self.append_before_sibling(element, child);
                } else {
                    self.append(previous_element, child);
                }
            }
            fn remove_from_parent(&self, target: &u32) {
                let mut nodes = self.nodes.borrow_mut();
                arena_detach(&mut nodes, *target);
            }
            fn reparent_children(&self, node: &u32, new_parent: &u32) {
                let mut nodes = self.nodes.borrow_mut();
                let children = std::mem::take(&mut nodes[*node as usize].children);
                let count = children.len();
                if count == 0 {
                    return;
                }
                let first = children[0];
                let last = children[count - 1];
                for child in &children {
                    nodes[*child as usize].parent = Some(*new_parent);
                }
                let previous = nodes[*new_parent as usize].children.last().copied();
                if let Some(previous) = previous {
                    nodes[previous as usize].next = Some(first);
                }
                nodes[first as usize].prev = previous;
                nodes[*new_parent as usize]
                    .children
                    .extend(children.iter().copied());
            }
            fn add_attrs_if_missing(&self, target: &u32, attrs: Vec<Attribute>) {
                let mut nodes = self.nodes.borrow_mut();
                let record = &mut nodes[*target as usize];
                for attr in attrs {
                    record.attribs.or_insert(
                        String::from(attr.name.local.as_ref()),
                        serde_json::Value::String(String::from(&*attr.value)),
                    );
                }
            }
            fn get_template_contents(&self, target: &u32) -> u32 {
                *self.nodes.borrow()[*target as usize]
                    .children
                    .first()
                    .expect("template without fragment contents")
            }
            fn mark_script_already_started(&self, _: &u32) {}
            fn set_quirks_mode(&self, mode: QuirksMode) {
                self.quirks.set(mode);
            }
            fn create_pi(&self, target: StrTendril, data: StrTendril) -> u32 {
                let mut nodes = self.nodes.borrow_mut();
                let id = nodes.len() as u32;
                let mut record = arena::DomNode::new("directive");
                record.id = id;
                record.name = Some(String::from(&**target));
                record.data = Some(String::from(&**data));
                nodes.push(record);
                id
            }
        }

        let card = |i: usize| format!(
            "<div class=\"card c{}\" id=\"d{}\" data-index=\"{}\"><header><a href=\"/p/{}\" title=\"Item {}\"><img src=\"/i/{}.png\" alt=\"x{}\" width=\"10\"></a></header><p>Lorem ipsum {} <b>bold</b> &amp; <i>more</i></p><ul><li>a</li><li class=\"x\">b</li></ul></div>",
            i % 7, i, i, i, i, i, i, i
        );
        let mut source = String::from("<!doctype html><html><head><title>Page</title><meta name=\"description\" content=\"d\"><script>var x = 1 < 2;</script></head><body><nav><a href=\"/\">Home</a></nav><main>");
        for i in 0..2000 {
            source.push_str(&card(i));
        }
        source.push_str("</main><footer>f</footer></body></html>");
        println!("fixture bytes: {}", source.len());

        // Correctness first: the direct arena must match the existing parse
        // + lazy conversion for this fixture.
        {
            let document =
                NativeDocument::parse_options(&source, true, serde_json::json!({}), None);
            document.ensure_arena().unwrap();
            let reference = document.arena.borrow();
            let reference = reference.as_ref().unwrap();
            let start = std::time::Instant::now();
            let arena = html5ever::driver::parse_document(ArenaSink::new(), Default::default())
                .one(source.as_str());
            let direct_build = start.elapsed();
            println!("arena sink built {} nodes in {:?}", arena.len(), direct_build);
            assert_eq!(arena.len(), reference.nodes.len(), "node count differs");
            for (index, (candidate, expected)) in
                arena.iter().zip(reference.nodes.iter()).enumerate()
            {
                assert_eq!(candidate.kind, expected.kind, "kind at {index}");
                assert_eq!(candidate.name, expected.name, "name at {index}");
                assert_eq!(candidate.data, expected.data, "data at {index}");
                assert_eq!(candidate.children, expected.children, "children at {index}");
                assert_eq!(candidate.parent, expected.parent, "parent at {index}");
                assert_eq!(
                    candidate.attribs.len(),
                    expected.attribs.len(),
                    "attr count at {index}"
                );
                for (name, value) in &expected.attribs {
                    let candidate_value = candidate
                        .attribs
                        .get(name)
                        .and_then(|value| value.as_str())
                        .unwrap_or("");
                    assert_eq!(
                        candidate_value,
                        value.as_str().unwrap_or(""),
                        "attribute {name} at {index}"
                    );
                }
            }
            std::hint::black_box(arena);
        }

        let mut direct_samples = Vec::new();
        let mut current_samples = Vec::new();
        for iteration in 0..40 {
            let start = std::time::Instant::now();
            let arena = html5ever::driver::parse_document(ArenaSink::new(), Default::default())
                .one(source.as_str());
            let direct = start.elapsed();
            std::hint::black_box(&arena);

            let start = std::time::Instant::now();
            let document =
                NativeDocument::parse_options(&source, true, serde_json::json!({}), None);
            document.ensure_arena().unwrap();
            let current = start.elapsed();
            std::hint::black_box(&document);

            if iteration >= 5 {
                direct_samples.push(direct);
                current_samples.push(current);
            }
        }
        let median = |mut samples: Vec<std::time::Duration>| {
            samples.sort_unstable();
            samples[samples.len() / 2]
        };
        println!(
            "direct arena sink: {:?}; current parse + lazy conversion: {:?}",
            median(direct_samples),
            median(current_samples),
        );
    }
